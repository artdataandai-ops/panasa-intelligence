# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored on purpose.
#
# IMPORTANT: rotate your Lyzr API key first. The previous key was committed to
# git inside src/environments/environment.ts, so it must be treated as leaked.
# Generate a new one at studio.lyzr.ai/configure/api-keys and put it below.

# Required: your Lyzr API key. Stays server-side, never sent to the browser.
LYZR_API_KEY=replace-with-rotated-lyzr-key

# Lyzr inference endpoint (default is correct for most setups).
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# Lyzr user id used for all calls.
LYZR_USER_ID=panasa-ops

# Comma-separated allowlist of agent ids the proxy is permitted to call.
# Leave empty to allow any agent (NOT recommended for public exposure).
LYZR_ALLOWED_AGENTS=6a1dc89af6b085eee307e2f9,6a1874f7da56d8978dfe6d0b,6a1b4098f7a1eb202d6463d1,6a1c822167d6ab6e880b8db2,6a1c863f80c734da121493ca,6a1db8f2e1bb0f24d59a05bc,6a1dc26d894f3fe88bd90740,6a2244e338260b371a447edc

# Port the server listens on.
PORT=3000

# Optional: override where the built Angular app is served from.
# Defaults to ../dist/panasa-intelligence/browser
# STATIC_DIR=/var/www/panasa-intelligence
